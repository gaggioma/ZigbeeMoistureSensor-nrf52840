/ {
	chosen {
		ncs,zigbee-timer = &timer2;
	};

	leds {
		compatible = "gpio-leds";

		led_zero: led_0 {
			gpios = <&gpio0 05 GPIO_ACTIVE_HIGH>;
			label = "Enable voltage divider";
			status = "okay";
		};

		led_blue: led_1 {
			gpios = <&gpio0 06 GPIO_ACTIVE_LOW>;
			label = "Blue led";
			status = "okay";
		};

		led_green: led_2 {
			gpios = <&gpio0 30 GPIO_ACTIVE_LOW>;
			label = "Green led";
			status = "okay";
		};

		led_red: led_3 {
			gpios = <&gpio0 26 GPIO_ACTIVE_LOW>;
			label = "Red led";
			status = "okay";
		};
	};

	/*ADC config https://academy.nordicsemi.com/courses/nrf-connect-sdk-intermediate/lessons/lesson-6-analog-to-digital-converter-adc/topic/exercise-1-interfacing-with-adc-using-zephyr-api/*/
	zephyr,user {
		io-channels = <&adc 0>, <&adc 1>;
	};

	//Aliases
	/* Optional: Create aliases for easy access in your C code */
	aliases {
		batteryenable = &led_zero;
		ledblue = &led_blue;
		ledgreen = &led_green;
		ledred = &led_red;
	};
};

&timer2 {
	status = "okay";
};

&adc {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	//Dafine channel for battery voltage adc
	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1_6"; //Max input voltage = reference / Gain = 0.6 / (1/6) = 3.6V
		zephyr,reference = "ADC_REF_INTERNAL"; //-> +0.6
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN0>; // P0.02 for nRF52xx
		zephyr,resolution = <12>;
	};

	//Define channel for sensor adc
	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1_6"; //Max input voltage = reference / Gain = 0.6 / (1/6) = 3.6V
		zephyr,reference = "ADC_REF_INTERNAL"; //-> +0.6
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,input-positive = <NRF_SAADC_AIN1>; // P0.03 for nRF52xx
		zephyr,resolution = <12>;
	};
};
